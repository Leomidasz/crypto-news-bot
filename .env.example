# คัดลอกไฟล์นี้เป็นชื่อ .env แล้วกรอกค่า  (ห้ามแชร์ไฟล์ .env ให้ใคร / ห้าม push ขึ้น GitHub)

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
# chat id ที่อนุญาต (คั่นด้วย , ได้หลายอัน) — รันบอทแล้วพิมพ์ /start เพื่อดูเลข
TELEGRAM_ALLOWED_CHAT_IDS=

# ===== X (Twitter) =====
X_BEARER_TOKEN=
# บัญชีที่จะติดตาม คั่นด้วย ,  (ใส่ @ หรือไม่ใส่ก็ได้)
X_ACCOUNTS=WatcherGuru,tier10k,lookonchain
# จำนวนโพสต์สูงสุดต่อบัญชีต่อครั้ง (5-100) — ยิ่งมากยิ่งแพง
X_MAX_POSTS_PER_ACCOUNT=20
# true = รวม reply ด้วย (ปกติไม่ต้อง)
X_INCLUDE_REPLIES=false

# ===== Discord =====
DISCORD_BOT_TOKEN=
# channel id ที่จะดึง คั่นด้วย ,
DISCORD_CHANNEL_IDS=
DISCORD_MAX_MESSAGES_PER_CHANNEL=300

# ===== Claude =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ===== ทั่วไป =====
DEFAULT_HOURS=12
